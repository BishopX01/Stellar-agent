# Copy from ../../demo/.env and add:
SELLER_SECRET=        # this seller's Stellar secret key (required, must be valid Stellar StrKey Ed25519 secret, e.g. S...)
AGENT_ID=seller-webbuilder   # change per seller folder (required)
PUBLIC_URL=           # public-facing base URL (optional, must be a valid URL; default: http://localhost:PORT)
# Example for ngrok: PUBLIC_URL=https://abc123.ngrok.io
# If unset, generated sites are served locally at http://localhost:PORT/output/job-{id}.html

# Required by the seller agent Zod schema (AgentConfigSchema):
STELLAR_RPC_URL=https://soroban-testnet.stellar.org   # required, must be a valid URL
NETWORK_PASSPHRASE=Test SDF Network ; September 2015   # required, Stellar network passphrase
SECRET_KEY=           # required, must be a valid Stellar StrKey Ed25519 secret (e.g. S...)
CONTRACT_ADDRESSES={}   # required, JSON object mapping contract names to Stellar contract addresses
PORT=3000   # required, integer between 1 and 65535