# agents/registry/.env.example
# Copy to agents/registry/.env and fill in values.
# See root .env.example and .env.schema for full variable reference.
#
# All values below are validated at boot against the registry Zod schema.
# Invalid or missing required values cause the agent to fail fast with a
# readable error table instead of crashing mid-execution.

# ── Agent registry ────────────────────────────────────────────────────────────
# Optional — leave blank to disable registry auth.
# When set, must be a non-empty string (no whitespace-only values).
REGISTRY_API_KEY=

# ── Stellar network ───────────────────────────────────────────────────────────
# Required. Must be a valid http(s) URL.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Required. Must match the network of STELLAR_RPC_URL.
# Allowed: TESTNET | PUBLIC | FUTURENET | STANDALONE
NETWORK_PASSPHRASE=TESTNET

# Required. Must be a valid Stellar StrKey Ed25519 secret key (starts with "S").
# Never commit a real secret key — use a placeholder in examples.
SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Required. JSON object mapping contract names to valid StrKey contract
# addresses (start with "C"). Must be valid JSON.
CONTRACT_ADDRESSES={"registry":"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4"}

# Required. Integer between 1 and 65535.
PORT=8080