# Copy from ../../demo/.env and add:
# Validated against the seller agent Zod schema (see .env.schema).
# Required: SELLER_SECRET must be a valid Stellar StrKey Ed25519 secret key (starts with "S").
SELLER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX   # this seller's Stellar secret key
AGENT_ID=seller-copywriter   # change per seller folder
PUBLIC_URL=http://localhost:3000   # public-facing base URL (default: http://localhost:PORT)
# Example for ngrok: PUBLIC_URL=https://abc123.ngrok.io
# If unset, generated sites are served locally at http://localhost:PORT/output/job-{id}.md