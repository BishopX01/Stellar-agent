{
  "name": "fastify-seller-agent",
  "version": "1.0.0",
  "description": "Production-ready Fastify seller agent template with x402 paywall middleware for Stellar payments",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "tsx scripts/benchmark.ts"
  },
  "keywords": [
    "fastify",
    "x402",
    "stellar",
    "seller-agent",
    "paywall",
    "marc-stellar-sdk",
    "template"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "fastify": "^4.28.1",
    "marc-stellar-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}