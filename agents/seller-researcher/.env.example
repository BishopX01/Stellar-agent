# agents/seller-researcher/.env.example
# Copy to agents/seller-researcher/.env and fill in values.
# See root .env.example and .env.schema for full variable reference.
#
# All variables below are validated at boot against AgentConfigSchema (Zod).
# Invalid or missing required values cause the agent to fail fast with a
# readable error table instead of crashing mid-execution.

# ── Stellar network ───────────────────────────────────────────────────────────
# Required. Must be a valid http(s) URL.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Required. Must match the network the RPC endpoint serves.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract addresses (testnet) ──────────────────────────────────────────────
# Required. Each must be a valid Stellar StrKey contract address (C...).
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── Seller agent ──────────────────────────────────────────────────────────────
# Required. Must be a valid Stellar secret key (S... StrKey Ed25519 seed).
# Generate with: stellar keys generate seller --network testnet --fund
SELLER_SECRET=
# Required. Integer between 1 and 65535.
SELLER_PORT=4504
# Optional. Public-facing base URL; must be a valid http(s) URL when set.
# Defaults to http://localhost:SELLER_PORT when empty.
# Example for ngrok: PUBLIC_URL=https://abc123.ngrok.io
PUBLIC_URL=

# ── Agent registry ────────────────────────────────────────────────────────────
# Required. Must be a valid http(s) URL.
REGISTRY_URL=http://localhost:4500
# Optional. Non-empty string when set.
REGISTRY_API_KEY=

# ── AI provider ───────────────────────────────────────────────────────────────
# Required for research generation. Get a free key at https://console.groq.com
GROQ_API_KEY=