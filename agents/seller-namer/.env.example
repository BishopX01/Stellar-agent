# agents/seller-namer/.env.example
# Copy to agents/seller-namer/.env and fill in values.
# See root .env.example and .env.schema for full variable reference.
# This file is validated against AgentConfigSchema in CI.

# ── Stellar network ───────────────────────────────────────────────────────────
# Must be a valid http(s) URL.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Must match the network passphrase for the RPC endpoint above.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract addresses (testnet) ──────────────────────────────────────────────
# Each must be a valid StrKey Ed25519 contract address (starts with "C").
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── Seller agent ──────────────────────────────────────────────────────────────
# Must be a valid StrKey Ed25519 secret key (starts with "S").
# Generate with: stellar keys generate seller --network testnet --fund
SECRET_KEY=
# Must be an integer between 1 and 65535.
PORT=4503
# Public-facing base URL (default: http://localhost:PORT). Must be a valid http(s) URL.
# Example for ngrok: PUBLIC_URL=https://abc123.ngrok.io
PUBLIC_URL=

# ── Agent registry ────────────────────────────────────────────────────────────
# Must be a valid http(s) URL.
REGISTRY_URL=http://localhost:4500
REGISTRY_API_KEY=

# ── AI provider ───────────────────────────────────────────────────────────────
# Required for name generation. Get a free key at https://console.groq.com
GROQ_API_KEY=