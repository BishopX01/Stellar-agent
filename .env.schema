# .env.schema
# -----------------------------------------------------------------------------
# Environment variable schema documentation for the agent crates and
# dashboard/server.ts.
#
# This file is human-readable documentation. The authoritative validation is
# performed at boot by the Zod schemas (AgentConfigSchema) in config.ts.
# Keep this file in sync with those schemas; CI verifies .env.example files
# against the Zod schemas.
#
# Legend:
#   type      - expected value type
#   required  - "yes" = must be present and non-empty; "no" = optional
#   default   - value applied when the variable is absent (if any)
#   rules     - validation rules enforced by Zod
# -----------------------------------------------------------------------------


# =============================================================================
# Stellar network configuration
# =============================================================================

# STELLAR_RPC_URL
#   type:     string (URL)
#   required: yes
#   default:  none
#   rules:    Must be a syntactically valid absolute URL (http/https).
#             Validated with z.string().url().
#   example:  https://soroban-testnet.stellar.org
STELLAR_RPC_URL=

# NETWORK_PASSPHRASE
#   type:     string
#   required: yes
#   default:  none
#   rules:    Must be a non-empty string. Must match the passphrase of the
#             network targeted by STELLAR_RPC_URL.
#   example:  Test SDF Network ; September 2015
NETWORK_PASSPHRASE=

# SECRET_KEY
#   type:     string (Stellar StrKey Ed25519 secret seed)
#   required: yes
#   default:  none
#   rules:    Must be a valid StrKey Ed25519 secret seed: starts with "S",
#             is 56 characters long, and passes the StrKey base32 + CRC16
#             checksum validation. Never commit real secret keys.
#   example:  SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SECRET_KEY=


# =============================================================================
# Contract addresses
# =============================================================================

# CONTRACT_ADDRESSES
#   type:     string (comma-separated list of Stellar StrKey Ed25519 public keys)
#   required: yes
#   default:  none
#   rules:    Must be a non-empty, comma-separated list. Each entry must be a
#             valid StrKey Ed25519 public key: starts with "G", is 56 characters
#             long, and passes the StrKey base32 + CRC16 checksum validation.
#             Whitespace around entries is trimmed.
#   example:  GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF,GBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
CONTRACT_ADDRESSES=


# =============================================================================
# Server configuration
# =============================================================================

# PORT
#   type:     integer
#   required: no
#   default:  3000
#   rules:    Must be a positive integer between 1 and 65535 (inclusive).
#             Parsed from the environment string and coerced to a number.
#   example:  3000
PORT=3000
</｜｜DSML｜｜ parameter>
</｜｜DSML｜｜ invoke>
</｜｜DSML｜｜ calls>