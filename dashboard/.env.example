# dashboard/.env.example
# Copy to dashboard/.env and fill in values.
# See root .env.example for full variable reference.
# This file is validated against the dashboard Zod schema in CI (see dashboard/src/config.ts).

# ── Stellar network ───────────────────────────────────────────────────────────
# Must be a valid URL (http/https).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Must match the network the RPC endpoint serves.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract addresses (testnet) ──────────────────────────────────────────────
# Must be valid Stellar StrKey contract addresses (start with "C").
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── Dashboard server ──────────────────────────────────────────────────────────
# Must be an integer between 1 and 65535.
DASHBOARD_PORT=3000
# Comma-separated list of allowed origins (each must be a valid URL).
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to pre-seed fixed testnet keypairs and skip Freighter auth.
# This lets you run the full dashboard locally without a browser wallet extension.
# When DEMO_MODE=false (default), BUYER_SECRET and SELLER_SECRET must be set.
# Accepted values: true | false
DEMO_MODE=false

# ── Wallet secrets (required when DEMO_MODE=false) ───────────────────────────
# Stellar secret keys for the buyer and seller demo accounts.
# Must be valid Stellar StrKey Ed25519 secret seeds (start with "S", 56 chars).
# Generate with: stellar keys generate mykey --network testnet --fund
# WARNING: Never commit real keys. Use testnet keys only.
BUYER_SECRET=S...
SELLER_SECRET=S...