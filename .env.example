# =============================================================================
# Bear Protocol — Root .env.example
# Copy this file to .env in the relevant package directory and fill in values.
# Each sub-package may also have its own .env.example with package-specific
# notes; this root file lists every variable used across the entire monorepo.
# =============================================================================

# ── Stellar network ───────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Offline local sandbox (docker-compose.yml, #787) ─────────────────────────
# `docker-compose up` writes these to .env.docker automatically; the values
# below are the defaults generated by the init service. Override any of them
# in .env.docker (or your shell) to point the stack at a different node.
# See README.md → "Offline Local Development".
#
# Local Stellar Quickstart standalone node (stellar/quickstart:testing).
# The RPC endpoint is exposed on the host at port 8000.
LOCAL_STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
LOCAL_STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
# Friendbot / funding endpoint for the local standalone network.
LOCAL_STELLAR_FRIENDBOT_URL=http://localhost:8000/friendbot
# Horizon endpoint (used by some tooling for account lookups).
LOCAL_STELLAR_HORIZON_URL=http://localhost:8000

# Contract addresses deployed by the init service on container boot.
# These are deterministic for the standalone network's default root keypair;
# the init service rewrites them in .env.docker if the deployer key changes.
LOCAL_USDC_TOKEN_CONTRACT=
LOCAL_AGENT_IDENTITY_CONTRACT=
LOCAL_AGENTIC_COMMERCE_CONTRACT=

# Test keypairs funded by the init service (via local friendbot).
# Leave blank to let the init service generate and persist fresh keypairs.
LOCAL_SELLER_SECRET=
LOCAL_SELLER_PUBKEY=
LOCAL_BUYER_SECRET=
LOCAL_BUYER_PUBKEY=
# Root/deployer keypair for the standalone network (stellar/quickstart default).
LOCAL_DEPLOYER_SECRET=
LOCAL_DEPLOYER_PUBKEY=

# ── Contract addresses (testnet) ──────────────────────────────────────────────
# Circle's canonical testnet USDC SAC on Stellar (from x402-stellar token catalog).
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── x402 facilitator ──────────────────────────────────────────────────────────
# Generate via: curl https://channels.openzeppelin.com/testnet/gen
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_FACILITATOR_API_KEY=
# Aliases consumed by seller agents / marcPaywall
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=

# ── Agent registry ────────────────────────────────────────────────────────────
REGISTRY_URL=http://localhost:4500
# Optional — leave blank to disable registry auth
REGISTRY_API_KEY=

# ── AI provider ───────────────────────────────────────────────────────────────
# Required by seller-researcher, seller-webbuilder, seller-copywriter, seller-namer.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ── Seller agents ─────────────────────────────────────────────────────────────
# Generate with: stellar keys generate seller --network testnet --fund
SELLER_SECRET=
SELLER_PUBKEY=
# Port defaults: webbuilder=4501, copywriter=4502, namer=4503, researcher=4504
SELLER_PORT=4501
# Public-facing base URL; set to ngrok/tunnel URL when exposing locally.
# Example: PUBLIC_URL=https://abc123.ngrok.io
# If unset, defaults to http://localhost:SELLER_PORT
PUBLIC_URL=
# Used by demo/seller-agent.ts
SELLER_SERVICE_PRICE=$0.01
# Per-seller agent identifier (change per seller folder)
AGENT_ID=seller-webbuilder

# ── Buyer agent ───────────────────────────────────────────────────────────────
# Generate with: stellar keys generate buyer --network testnet --fund
BUYER_SECRET=
# Optional polling tuning
BUYER_POLL_BASE_MS=2000
BUYER_POLL_MULTIPLIER=2
BUYER_POLL_MAX_ATTEMPTS=10
BUYER_POLL_CAP_MS=30000

# ── Job ID (seller-agent.ts deliverable submission) ───────────────────────────
JOB_ID=

# ── Dashboard (dashboard/server.ts) ───────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SEP-0010 Web Authentication (#728)
# Server keypair used to sign challenge transactions. Generate with:
#   stellar keys generate dashboard --network testnet --fund
# The public key is embedded in the challenge tx; the secret signs it.
DASHBOARD_SIGNING_SECRET=
# home_domain advertised in the SEP-0010 challenge (must match the serving domain).
DASHBOARD_HOME_DOMAIN=localhost
# Secret used to sign 24-hour session JWTs issued by POST /api/auth/token.
# Generate via: openssl rand -hex 32
DASHBOARD_JWT_SECRET=

# ── OpenTelemetry distributed tracing (#726) ─────────────────────────────────
# OTLP collector endpoint (Jaeger / Grafana Tempo / otel-collector).
# Example: http://localhost:4318 (HTTP) or http://localhost:4317 (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name reported in traces; override per agent (e.g. seller-webbuilder).
OTEL_SERVICE_NAME=bear-protocol
# Trace sampler: parentbased_always_on | parentbased_traceidratio | always_on | always_off
OTEL_TRACES_SAMPLER=parentbased_always_on
# Optional ratio for parentbased_traceidratio sampler (0.0–1.0)
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Remote signing — AWS KMS / HashiCorp Vault (#727) ────────────────────────
# When set, agents sign Stellar transactions via the remote signer instead of
# loading plaintext secrets (SELLER_SECRET / BUYER_SECRET) into memory.
# AWS KMS (Ed25519 key, SIGN_VERIFY usage)
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
# HashiCorp Vault Transit engine
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY=bear-agent-signer

# ── TUI / simulate.ts — 4 seller + 5 buyer accounts ──────────────────────────
# Fund each via https://laboratory.stellar.org/#account-creator?network=test
# then add USDC trustline + balance via https://faucet.circle.com (Stellar Testnet)
SELLER_SECRET_1=
SELLER_SECRET_2=
SELLER_SECRET_3=
SELLER_SECRET_4=

BUYER_SECRET_1=
BUYER_SECRET_2=
BUYER_SECRET_3=
BUYER_SECRET_4=
BUYER_SECRET_5=
