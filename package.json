{
  "name": "bear-protocol",
  "version": "0.1.0",
  "description": "Commerce layer for AI agent payments built on the Stellar blockchain",
  "private": true,
  "workspaces": [
    "sdk",
    "dashboard",
    "demo",
    "landing",
    "agents",
    "agents/*",
    "indexer",
    "packages/react",
    "examples/nextjs-starter"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "test": "cargo test --workspace && npm run test --workspaces --if-present",
    "test:rust": "cargo test --workspace",
    "test:ts": "npm run test --workspaces --if-present",
    "test:react": "npm run test --workspace packages/react",
    "state:dump": "tsx scripts/state-dump.ts",
    "gas:check": "tsx scripts/measure-gas.ts",
    "gas:update": "tsx scripts/measure-gas.ts --update",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,json,md,ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-trace-node": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "tsx": "^4.19.2"
  }
}